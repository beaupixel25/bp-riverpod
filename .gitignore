.DS_Store
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# Build output. Unanchored so it also catches packages/*/build — the
# per-package .gitignore files anchor their own rule and miss it.
build/
coverage/

# Generated Dart — build_runner output (freezed, json_serializable,
# go_router_builder, riverpod_generator). Recreated by `melos build`;
# hand-editing one is reverted by the next build, so there is nothing
# in them worth reviewing in a diff.
*.freezed.dart
*.g.dart

# Swift Package Manager
.build/
.swiftpm/
*.iml
.idea/

# Keep shared VSCode debug configs (launch.json) tracked, ignore the rest.
# A blanket `.vscode/` would exclude the directory outright and prevent any
# nested package from re-including its launch.json, so ignore contents instead.
**/.vscode/*
!**/.vscode/launch.json
pubspec.lock
.env
.env.local
*.swp
*.swo
